{
    "version": 3,
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}"
        },
        {
            "name": "windows-gcc",
            "hidden": true,
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc.exe",
                "CMAKE_CXX_COMPILER": "g++.exe"
            }
        },
        {
            "name": "windows-msvc",
            "hidden": true,
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "windows-gcc-x64-debug",
            "displayName": "Windows Debug x64 GCC",
            "inherits": "windows-gcc",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-gcc-x64-release",
            "displayName": "Windows Release x64 GCC",
            "inherits": "windows-gcc",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "windows-msvc-x64-debug",
            "displayName": "Windows Debug x64 MSVC",
            "inherits": "windows-msvc",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-msvc-x64-release",
            "displayName": "Windows Release x64 MSVC",
            "inherits": "windows-msvc",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "win-gcc-x64-dbg",
            "configurePreset": "windows-gcc-x64-debug"
        },
        {
            "name": "win-gcc-x64-rel",
            "configurePreset": "windows-gcc-x64-release"
        },
        {
            "name": "win-msvc-x64-dbg",
            "configurePreset": "windows-msvc-x64-debug"
        },
        {
            "name": "win-msvc-x64-rel",
            "configurePreset": "windows-msvc-x64-release"
        }
    ]
}
